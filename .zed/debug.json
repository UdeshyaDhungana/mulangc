[
  {
    "label": "Debug My Binary with Args",
    "adapter": "CodeLLDB",
    "request": "launch",
    "sourceLanguages": [
      "rust"
    ],
    "build": {
      "command": "cargo",
      "args": [
        "build"
      ]
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/mulang",
    "args": [
      "test.mu"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Debug IR Text Mode",
    "adapter": "CodeLLDB",
    "request": "launch",
    "sourceLanguages": [
      "rust"
    ],
    "build": {
      "command": "cargo",
      "args": [
        "build"
      ]
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/mulang",
    "args": [
      "--irtext",
      "test.mu"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
