// `ra` (and) and `wa` (or) take booleans, which are 1 and 0 internally.
// Both operands are always evaluated.

dhanda noise() {
    bol(999);
    de ho;
}

// The truth tables.
bol(ho ra ho);
bol(ho ra haina);
bol(haina ra ho);
bol(haina ra haina);
bol(ho wa ho);
bol(ho wa haina);
bol(haina wa ho);
bol(haina wa haina);

// Left-associative, and `ra` binds tighter than `wa`.
bol(ho ra ho ra haina);
bol(haina wa haina wa ho);
bol(ho wa haina ra haina);
bol(haina ra ho wa ho);

// Comparisons produce the booleans these operate on, so they bind tighter.
bol(1 < 2 ra 3 < 4);
bol(1 < 2 ra 4 < 3);
bol(1 > 2 wa 3 < 4);
bol(2 == 2 ra 2 != 2);

// Both sides run: `noise` prints even when the left operand already
// determines the result.
bol(haina ra noise());
bol(ho wa noise());

// As a stored value, and as a condition.
thoos a = ho ra haina;
bol(a);
thoos b = haina wa ho;
bol(b);

yedi (ho ra haina) {
    bol(1);
} natra {
    bol(2);
}

yedi (haina wa ho) {
    bol(30);
}
