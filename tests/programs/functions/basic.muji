// Calls: arguments, return values used in expressions, nested calls,
// and a function with no parameters.

dhanda add(a, b) {
    de a + b;
}

dhanda one() {
    de 1;
}

dhanda muji() {
    bol(add(2, 3));
    bol(add(add(1, 2), 4));
    bol(one());
    bol(add(one(), one()));

    thoos t = add(10, 20);
    bol(t);
    bol(t * 2);
}
