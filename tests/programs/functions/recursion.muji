// Recursion: a single self-call, and a doubly-recursive one.

dhanda fac(n) {
    yedi (n == 0) {
        de 1;
    }
    de n * fac(n - 1);
}

dhanda fib(n) {
    yedi (n < 2) {
        de n;
    }
    de fib(n - 1) + fib(n - 2);
}

bol(fac(0));
bol(fac(5));
bol(fib(0));
bol(fib(1));
bol(fib(10));
