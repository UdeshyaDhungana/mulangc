// A function reading a name from an enclosing scope.
//
// Identifier resolution walks outward through `self.frames`, reaching outer
// locals as positive offsets from the innermost `x29`. That is valid for
// blocks inside one function, whose frames are contiguous. It is not valid
// across a call: below a function's frame at run time sits *the caller's*
// frame, which differs from call site to call site.
//
// So `peek` must give the same answer however it is reached.

thoos g = 5;

dhanda peek() {
    de g;
}

dhanda middle(a, b, c) {
    de peek();
}

bol(peek());
bol(middle(1, 2, 3));
