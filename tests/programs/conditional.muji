// Every arm of a yedi / nabhae / natra chain, plus a
// bare yedi with no alternative.

thoos positive = 5;
thoos zero = 0;
thoos negative = -5;

yedi (positive > 0) {
    bol(1);
} nabhae (positive < 0) {
    bol(2);
} natra {
    bol(3);
}

yedi (negative > 0) {
    bol(1);
} nabhae (negative < 0) {
    bol(2);
} natra {
    bol(3);
}

yedi (zero > 0) {
    bol(1);
} nabhae (zero < 0) {
    bol(2);
} natra {
    bol(3);
}

yedi (positive == 5) {
    bol(4);
}
